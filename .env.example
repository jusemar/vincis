DATABASE_URL="postgresql://usuario:senha@host:5432/banco"
APP_URL="http://localhost:5173"
RESEND_API_KEY="re_substitua_pela_chave"

# Remetente do e-mail de confirmação.
#
# Precisa pertencer a um domínio verificado em resend.com/domains. Enquanto a
# conta não tiver domínio verificado, o Resend opera em modo de teste: aceita
# apenas `onboarding@resend.dev` como remetente e só entrega no endereço do
# dono da conta, recusando qualquer outro destinatário com HTTP 403.
EMAIL_FROM="Vincis <confirmacao@seu-dominio.com>"

# ---------------------------------------------------------------------------
# Tempo real (Pusher Channels)
# ---------------------------------------------------------------------------
#
# Sem estas variáveis a aplicação funciona inteira: Server Actions gravam, o
# refresh busca o estado real e nada quebra — apenas a atualização deixa de ser
# instantânea. Preencha com as credenciais do seu app em dashboard.pusher.com
# (Channels → App Keys). Não existe valor padrão embutido no código.
#
# Segredo de servidor (nunca vai para o navegador):
PUSHER_APP_ID="000000"
PUSHER_KEY="chave_do_app"
PUSHER_SECRET="segredo_do_app"
PUSHER_CLUSTER="sa1"
#
# Chave pública do navegador. Ela só permite **pedir** a assinatura de um canal
# privado; quem assina é /api/realtime/auth, depois de conferir sessão e vínculo.
# Devem repetir os valores de PUSHER_KEY e PUSHER_CLUSTER.
NEXT_PUBLIC_PUSHER_KEY="chave_do_app"
NEXT_PUBLIC_PUSHER_CLUSTER="sa1"

# ---------------------------------------------------------------------------
# Agendador (Vercel Cron)
# ---------------------------------------------------------------------------
#
# Autentica a rota /api/cron/processar-prazos, que expira solicitações e
# convites vencidos e emite os avisos de prazo. `CRON_SECRET` é o nome que a
# Vercel reconhece: definida no projeto, ela passa a enviar
# `Authorization: Bearer <valor>` em toda execução agendada, sem código nosso.
#
# Sem esta variável o agendador fica DESLIGADO — a rota responde 503 em vez de
# liberar. Ausência de segredo é configuração incompleta, não permissão.
#
# Use um valor longo e aleatório (por exemplo `openssl rand -hex 32`).
CRON_SECRET="segredo_longo_e_aleatorio"

# ---------------------------------------------------------------------------
# Daily (videochamada da Consultoria Agendada)
# ---------------------------------------------------------------------------
#
# Credencial de domínio da Daily: quem a tem cria salas, lê salas e emite
# tokens de participante para qualquer sala da conta. Por isso ela é lida
# **apenas** no servidor, em src/features/videochamada/lib/daily/cliente-daily.ts
# — o único módulo que fala com a API — e esse módulo é marcado com
# `server-only`, o que faz o build falhar se algum componente de cliente tentar
# importá-lo.
#
# NÃO existe versão `NEXT_PUBLIC_` desta variável, e não deve existir: o
# navegador nunca precisa da chave. Ele recebe apenas a URL da sala privada e um
# meeting token temporário, emitido no clique, limitado àquela sala e àquele
# participante, e válido só durante a janela da consultoria.
#
# Sem esta variável a videochamada responde com a mensagem amigável de falha —
# o resto da Consultoria Agendada (calendário, reserva, pagamento, Atendimento)
# continua funcionando normalmente.
DAILY_API_KEY="chave_da_conta_daily"
