DATABASE_URL="postgresql://usuario:senha@host:5432/banco"
APP_URL="http://localhost:5173"
RESEND_API_KEY="re_substitua_pela_chave"

# Remetente do e-mail de confirmação.
#
# Precisa pertencer a um domínio verificado em resend.com/domains. Enquanto a
# conta não tiver domínio verificado, o Resend opera em modo de teste: aceita
# apenas `onboarding@resend.dev` como remetente e só entrega no endereço do
# dono da conta, recusando qualquer outro destinatário com HTTP 403.
EMAIL_FROM="Vincis <confirmacao@seu-dominio.com>"

# ---------------------------------------------------------------------------
# Tempo real (Pusher Channels)
# ---------------------------------------------------------------------------
#
# Sem estas variáveis a aplicação funciona inteira: Server Actions gravam, o
# refresh busca o estado real e nada quebra — apenas a atualização deixa de ser
# instantânea. Preencha com as credenciais do seu app em dashboard.pusher.com
# (Channels → App Keys). Não existe valor padrão embutido no código.
#
# Segredo de servidor (nunca vai para o navegador):
PUSHER_APP_ID="000000"
PUSHER_KEY="chave_do_app"
PUSHER_SECRET="segredo_do_app"
PUSHER_CLUSTER="sa1"
#
# Chave pública do navegador. Ela só permite **pedir** a assinatura de um canal
# privado; quem assina é /api/realtime/auth, depois de conferir sessão e vínculo.
# Devem repetir os valores de PUSHER_KEY e PUSHER_CLUSTER.
NEXT_PUBLIC_PUSHER_KEY="chave_do_app"
NEXT_PUBLIC_PUSHER_CLUSTER="sa1"
